# Examples only. Copy needed values to ignored .env.local or set environment variables.
VISION_VAR_ROOT=
VISION_FFMPEG=
VISION_FFPROBE=

# Optional isolated agent demo; normal deployment defaults to false.
VISION_AGENT_DEMO=false

# MediaMTX listeners must remain on loopback; cameras use its published RTSP URL.
VISION_MEDIA_GATEWAY_API_URL=http://127.0.0.1:9997
VISION_MEDIA_GATEWAY_HLS_URL=http://127.0.0.1:8888
VISION_MEDIA_GATEWAY_RTSP_PORT=8554

# Optional DeepSeek template matcher. Never commit the actual key.
VISION_DEEPSEEK_API_KEY=
VISION_DEEPSEEK_MODEL=deepseek-flash
VISION_DEEPSEEK_MATCH_THRESHOLD=0.8

# Optional OpenAI-compatible multimodal API. Remote endpoints require HTTPS and a key.
# A loopback HTTP endpoint may omit the key, allowing the same adapter to use a future local model.
VISION_MULTIMODAL_API_URL=
VISION_MULTIMODAL_API_KEY=
VISION_MULTIMODAL_MODEL=
VISION_MULTIMODAL_API_TIMEOUT_SECONDS=60
VISION_MULTIMODAL_MATCH_THRESHOLD=0.8
VISION_MULTIMODAL_MAX_FRAMES=8
VISION_MULTIMODAL_MAX_IMAGE_BYTES=2097152

# Model file import limit in bytes (default 1 GiB).
VISION_MAX_MODEL_FILE_BYTES=1073741824
